# Copy to .env.local for development. Never commit real values.

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000            # https://bench.purveycpg.com in production
NEXT_PUBLIC_MAIN_SITE_URL=https://www.purveycpg.com

# Supabase (Project settings -> API). The anon key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Billing sync, cron and upload validation. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test keys in development/preview). Product: price lookup key bench_listing_monthly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Vercel Cron auth for /api/cron/sync-listings
CRON_SECRET=

# Share the session with the purveycpg.com iframe. Leave empty for localhost.
COOKIE_DOMAIN=                                       # .purveycpg.com in production

# Cloudflare Turnstile (sign-up and a brand's first message). Test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local policy tests (npm run db:local prints this)
DATABASE_URL=postgresql://postgres@localhost:54329/postgres
